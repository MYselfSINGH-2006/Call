{
  "id": "/",
  "name": "PureSuite — Default Phone & Contacts",
  "short_name": "PureSuite",
  "description": "Native Default Phone Dialler & Default Contacts App with Silent Anti-Bomber protection and 13 Themes.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#111827",
  "theme_color": "#16a34a",
  "categories": ["utilities", "communication"],
  "protocol_handlers": [
    {
      "protocol": "tel",
      "url": "/?call=%s"
    },
    {
      "protocol": "web+contact",
      "url": "/?contact=%s"
    }
  ],
  "shortcuts": [
    {
      "name": "Phone Dialler",
      "short_name": "Phone",
      "description": "Open default dialler and keypad",
      "url": "/?tab=phone",
      "icons": [{ "src": "/favicon.ico", "sizes": "64x64" }]
    },
    {
      "name": "Contacts",
      "short_name": "Contacts",
      "description": "Open default contacts address book",
      "url": "/?tab=contacts",
      "icons": [{ "src": "/favicon.ico", "sizes": "64x64" }]
    }
  ],
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "64x64 32x32 24x24 16x16",
      "type": "image/x-icon",
      "purpose": "any"
    }
  ]
}
